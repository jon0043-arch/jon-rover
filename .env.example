# Server-side only. Never expose this as NEXT_PUBLIC_OPENAI_API_KEY.
OPENAI_API_KEY=sk-...

# Optional. Defaults to the cost-efficient model used for Jon's Picks.
OPENAI_MODEL=gpt-5.6-luna

# Canonical production URL used for SEO metadata, sitemap, robots, and structured data.
# Example: https://jonrover.com
NEXT_PUBLIC_SITE_URL=

# Google Search Console HTML-tag verification token only (the value inside content="...").
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
